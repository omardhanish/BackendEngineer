{
  "name": "backend-engineer-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living, book-style backend engineering course on localhost, with a per-page AI tutor and saved chats.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:vendor": "node tools/build-vendor.mjs",
    "validate": "node tools/validate.mjs",
    "capture": "node tools/capture.mjs",
    "examples:install": "npm install --prefix content/code --no-audit --no-fund",
    "qa:shots": "node tools/qa-shots.mjs",
    "smoke:chat": "node tools/smoke-chat.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "node tools/e2e.mjs",
    "e2e:challenges": "node tools/e2e-challenges.mjs",
    "scan": "bash tools/scan-secrets.sh",
    "contrast": "node tools/check-contrast.mjs"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "ajv": "^8.20.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "markdown-it": "^15.0.2",
    "path-browserify": "^1.0.1",
    "prismjs": "^1.30.0",
    "puppeteer-core": "^24.43.1"
  }
}
