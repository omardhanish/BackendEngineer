{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "outline.schema.json",
  "title": "Book outline (input of tools/createbook/new-book.mjs)",
  "description": "What the learner asked for: a book's identity plus its chapters and page headings. The scaffold turns it into book.json and syllabus.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "chapters"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "description": "Folder name and URL: /b/<slug>. Lowercase letters, digits and dashes." },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tagline": { "type": "string", "maxLength": 160, "description": "One line on the cover." },
    "audience": { "type": "string", "maxLength": 240, "description": "Who it is for and what they already know." },
    "profile": { "enum": ["js", "python", "java", "c", "none", "mixed"], "description": "Which code the book runs for real: js (Node), python, java, c, none (concepts only) or mixed." },
    "hue": { "type": "integer", "minimum": 0, "maximum": 359, "description": "Cover colour. Leave out and the scaffold picks one far from the other books." },
    "order": { "type": "number", "description": "Shelf position (lower first). Leave out to go after the existing books." },
    "monogram": { "type": "string", "minLength": 1, "maxLength": 3 },
    "locale": { "type": "string", "maxLength": 12 },
    "tutor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "about": { "type": "string", "maxLength": 600 },
        "examples": { "type": "string", "maxLength": 160 },
        "learnerRole": { "type": "string", "maxLength": 40 },
        "mentorRole": { "type": "string", "maxLength": 60 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bannedApis": { "type": "array", "maxItems": 40, "items": { "type": "string" } },
        "banHint": { "type": "string", "maxLength": 80 }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "topics"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "tagline": { "type": "string", "maxLength": 120 },
          "outcomes": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 3, "maxLength": 100 } },
          "hue": { "type": "integer", "minimum": 0, "maximum": 359 },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 99,
            "items": {
              "anyOf": [
                { "type": "string", "minLength": 1, "maxLength": 160 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title"],
                  "properties": {
                    "title": { "type": "string", "minLength": 1, "maxLength": 160, "description": "The heading the learner gave. The page's own short title is written later." },
                    "kind": { "enum": ["lecture", "challenge", "roleplay", "bonus"] },
                    "depth": { "enum": [1, 2, 3], "description": "1 = a quick idea, 2 = a normal page, 3 = a deep one (analogy and animation expected)." }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
