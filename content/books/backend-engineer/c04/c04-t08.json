  ],
  "pitfalls": [
    "Forget both `next()` and a response, and the request hangs forever.",
    "Order matters: middleware registered after a route never runs for it.",
    "Error handlers need four arguments: `(err, req, res, next)`."
  ],
  "quiz": {
    "q": "A middleware sends a response and never calls next(). What happens?",
    "options": [
      "The next middleware still runs",
      "The request ends there",
      "Express throws an error",
      "The request hangs"
    ],
    "answer": 1,
    "why": "Sending a response ends the cycle. Later middleware and the route never run."
  },
  "takeaway": "Middleware is a chain: pass it with next(), or end it with a response.",
  "chat": {
    "starters": [
      "What is the difference between app.use and app.get?",
      "How do I write an error-handling middleware?",
      "Where does express.json() fit in?"
    ]
  }
}
