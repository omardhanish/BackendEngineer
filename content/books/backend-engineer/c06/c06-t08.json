{
  "title": "Role-based authorization in Express",
  "idea": "`requireRole(...roles)` builds a middleware. That middleware lets a request pass only when `req.user.role` is listed; otherwise it sends `403`.",
  "analogy": {
    "text": "An office building. The front desk checks your badge is real; each door reader then checks the badge level.",
    "breaks": "Real readers check the badge themselves; `requireRole` trusts what `authenticate` stored."
  },
  "points": [
    "`authenticate` runs first and sets `req.user`; `requireRole` then reads `req.user.role`.",
    "`requireRole` sends `403`, never `401`: by then the caller is known.",
    "List several roles to allow any of them: `requireRole('user', 'admin')`.",
    "`requireRole` works the same whether `authenticate` reads a session or a JWT."
  ],
  "hero": {
    "type": "anim",
    "engine": "pipeline",
    "title": "Guards are set per route",
    "scenario": {
      "token": {
        "label": "GET /books",
        "tone": "req"
      },
      "stages": [
        {
          "id": "client",
          "label": "Client",
          "kind": "end"
        },
        {
          "id": "auth",
          "label": "authenticate",
          "sub": "who are you?"
        },
        {
          "id": "role",
          "label": "requireRole",
          "sub": "('admin')"
        },
        {
          "id": "route",
          "label": "Handler",
          "sub": "route code",
          "kind": "end"
        }
      ],
      "steps": [
        {
          "caption": "Ada has role `user`. She calls `GET /books`.",
          "at": "client",
          "slot": "top",
          "token": {
            "label": "GET /books",
            "tone": "req"
          },
          "state": {
            "client": "active"
          },
          "out": []
        },
        {
          "caption": "`authenticate` verifies her token and sets `req.user`.",
          "at": "auth",
          "slot": "top",
          "state": {
            "client": "done",
            "auth": "active"
          },
          "out": [
            "authenticate: Ada, role user"
          ]
        },
        {
          "caption": "This route has no `requireRole`, so the request skips to the handler.",
          "at": "route",
          "slot": "top",
          "state": {
            "client": "done",
            "auth": "done",
            "route": "active"
          },
          "out": [
            "authenticate: Ada, role user",
            "handler: list books"
          ]
        },
        {
          "caption": "The handler answers `200`. Any logged-in user may list books.",
          "at": "client",
          "slot": "top",
          "token": {
            "label": "200 OK",
            "tone": "ok"
          },
          "state": {
            "client": "active",
            "auth": "done",
            "route": "done"
          },
          "out": [
            "authenticate: Ada, role user",
            "handler: list books"
          ]
        },
        {
          "caption": "Ada calls `GET /users`. This route adds `requireRole('admin')`.",
          "at": "client",
          "slot": "top",
          "token": {
            "label": "GET /users",
            "tone": "req"
          },
          "state": {
            "client": "active"
          },
          "out": []
        },
        {
          "caption": "`authenticate` passes her on again.",
          "at": "auth",
          "slot": "top",
          "state": {
            "client": "done",
            "auth": "active"
          },
          "out": [
            "authenticate: Ada, role user"
          ]
        },
        {
          "caption": "`requireRole('admin')` looks for `user` in `['admin']` and finds nothing. It sends `403`.",
          "at": "role",
          "slot": "bottom",
          "token": {
            "label": "403",
            "tone": "err"
          },
          "state": {
            "client": "done",
            "auth": "done",
            "role": "blocked"
          },
          "out": [
            "authenticate: Ada, role user",
            "requireRole: user not in [admin]"
          ]
        },
        {
          "caption": "The client gets `403`. Ada is known, but not allowed.",
          "at": "client",
          "slot": "top",
          "token": {
            "label": "403",
            "tone": "err"
          },
          "state": {
            "client": "active",
            "auth": "done",
            "role": "blocked"
          },
          "out": [
            "authenticate: Ada, role user",
            "requireRole: user not in [admin]"
          ]
        },
        {
          "caption": "Grace has role `admin`. She calls the same route and passes both checks.",
          "at": "role",
          "slot": "top",
          "token": {
            "label": "GET /users",
            "tone": "req"
          },
          "state": {
            "client": "done",
            "auth": "done",
            "role": "active"
          },
          "out": [
            "authenticate: Grace, role admin",
            "requireRole: admin allowed"
          ]
        },
        {
          "caption": "The handler runs, and Grace gets `200` with the user list.",
          "at": "route",
          "slot": "top",
          "token": {
            "label": "200 OK",
            "tone": "ok"
          },
          "state": {
            "client": "done",
            "auth": "done",
            "role": "done",
            "route": "active"
          },
          "out": [
            "authenticate: Grace, role admin",
            "requireRole: admin allowed",
            "handler: list users"
          ]
        }
      ]
    }
  },
