  "pitfalls": [
    "Put `authenticate` first. Without `req.user`, `requireRole` denies everyone, even admins.",
    "A role copied into a JWT goes stale: a demoted admin keeps access until expiry.",
    "Guard every route that needs it. A route without `requireRole` allows any logged-in user."
  ],
  "quiz": {
    "q": "What does this print?",
    "code": "const guard = (role) => (user) =>\n  !user ? 401 : user.role === role ? 200 : 403;\nconst admin = guard('admin');\nconsole.log(admin(null), admin({ role: 'user' }), admin({ role: 'admin' }));",
    "lang": "js",
    "options": [
      "401 403 200",
      "403 401 200",
      "401 200 403",
      "403 403 200"
    ],
    "answer": 0,
    "why": "`null` means nobody is logged in: 401. A known user with the wrong role gets 403. The right role passes with 200."
  },
  "takeaway": "`authenticate` answers 401, `requireRole` answers 403, in that order.",
