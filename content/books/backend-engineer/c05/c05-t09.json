            "error 23503"
          ]
        },
        {
          "caption": "Your app receives the error. `books` is unchanged.",
          "at": "app",
          "slot": "bottom",
          "token": {
            "label": "23503",
            "tone": "err"
          },
          "state": {
            "app": "error",
            "books": "blocked",
            "fk": "error",
            "authors": "done"
          },
          "out": [
            "insert author_id 99",
            "authors: no id 99",
            "error 23503"
          ]
        },
        {
