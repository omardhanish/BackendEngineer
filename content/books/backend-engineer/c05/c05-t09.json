{
  "title": "Foreign keys and joins",
  "idea": "A foreign key is a column whose values must match the key of a row in another table. Postgres rejects any non-null value that points nowhere.",
  "points": [
    "`authors` stores each name once; each book keeps only that author's `id` in `author_id`.",
    "`references authors(id)` makes the link a rule Postgres enforces.",
    "A join pairs rows whose columns match; Drizzle writes it as `innerJoin`.",
    "By default, deleting an author who still has books fails; `onDelete` changes that."
  ],
  "hero": {
    "type": "anim",
    "engine": "pipeline",
    "title": "The foreign key checks each new value",
    "scenario": {
      "token": {
        "label": "author_id 99",
        "tone": "req"
      },
      "stages": [
        {
          "id": "app",
          "label": "Your app",
          "sub": "insert a book",
          "kind": "end"
        },
        {
          "id": "books",
          "label": "books",
          "sub": "author_id"
        },
        {
          "id": "fk",
          "label": "Foreign key",
          "sub": "references authors(id)"
        },
        {
          "id": "authors",
          "label": "authors",
          "sub": "id",
          "kind": "end"
        }
      ],
      "steps": [
        {
          "caption": "Your app inserts a book whose `author_id` is 99.",
          "at": "app",
          "slot": "top",
          "state": {
            "app": "active"
          },
          "out": []
        },
        {
          "caption": "Postgres writes the new row into `books`.",
          "at": "books",
          "slot": "top",
          "state": {
            "app": "done",
            "books": "active"
          },
          "out": [
            "insert author_id 99"
          ]
        },
        {
          "caption": "At the end of the statement, the foreign key checks the new value against `authors`.",
          "at": "fk",
          "slot": "top",
          "state": {
            "app": "done",
            "books": "done",
            "fk": "active"
          },
          "out": [
            "insert author_id 99"
          ]
        },
        {
          "caption": "Does `authors` have a row with `id` 99? It does not.",
          "at": "authors",
          "slot": "top",
          "state": {
            "app": "done",
            "books": "done",
            "fk": "active",
            "authors": "active"
          },
          "out": [
            "insert author_id 99",
            "authors: no id 99"
          ]
        },
        {
          "caption": "No match, so the statement fails with error code `23503`. The new row is undone.",
