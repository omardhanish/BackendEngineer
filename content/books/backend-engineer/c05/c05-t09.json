          "slot": "top",
          "token": {
            "label": "author_id 1",
            "tone": "req"
          },
          "state": {
            "app": "done",
            "books": "active"
          },
          "out": [
            "insert author_id 99",
            "authors: no id 99",
            "error 23503",
            "insert author_id 1"
          ]
        },
        {
          "caption": "At the end of the statement, the foreign key runs the same check.",
          "at": "fk",
          "slot": "top",
          "token": {
            "label": "author_id 1",
            "tone": "req"
          },
          "state": {
            "app": "done",
            "books": "done",
            "fk": "active"
          },
          "out": [
            "insert author_id 99",
            "authors: no id 99",
            "error 23503",
            "insert author_id 1"
          ]
        },
        {
          "caption": "`authors` has a row with `id` 1: a match.",
          "at": "authors",
          "slot": "top",
          "token": {
            "label": "author_id 1",
            "tone": "req"
          },
          "state": {
            "app": "done",
            "books": "done",
            "fk": "active",
            "authors": "active"
          },
          "out": [
            "insert author_id 99",
            "authors: no id 99",
            "error 23503",
            "insert author_id 1",
            "authors: id 1 found"
          ]
        },
        {
          "caption": "The check passes.",
          "at": "fk",
          "slot": "bottom",
          "token": {
            "label": "match",
            "tone": "ok"
          },
          "state": {
            "app": "done",
            "books": "done",
            "fk": "done",
            "authors": "done"
          },
          "out": [
            "insert author_id 99",
            "authors: no id 99",
            "error 23503",
            "insert author_id 1",
            "authors: id 1 found"
          ]
        },
        {
          "caption": "The row stays in `books`.",
          "at": "books",
          "slot": "bottom",
          "token": {
            "label": "stored",
            "tone": "ok"
          },
          "state": {
            "app": "done",
            "books": "active",
            "fk": "done",
            "authors": "done"
          },
          "out": [
            "insert author_id 99",
            "authors: no id 99",
            "error 23503",
            "insert author_id 1",
            "authors: id 1 found",
            "row stored"
          ]
        },
        {
          "caption": "Your app receives the stored book.",
          "at": "app",
          "slot": "bottom",
          "token": {
            "label": "stored",
            "tone": "ok"
          },
          "state": {
            "app": "active",
            "books": "done",
            "fk": "done",
            "authors": "done"
          },
          "out": [
            "insert author_id 99",
            "authors: no id 99",
            "error 23503",
            "insert author_id 1",
            "authors: id 1 found",
            "row stored"
          ]
