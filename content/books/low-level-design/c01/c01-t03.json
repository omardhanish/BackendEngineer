    "title": "Objects, fields and the prototype",
    "scenario": {
      "code": [
        "class Shape {",
        "  area() { return 0; }",
        "}",
        "class Rect extends Shape {",
        "  constructor(w, h) { super(); this.w = w; this.h = h; }",
        "  area() { return this.w * this.h; }",
        "}",
        "const r = new Rect(2, 3);",
        "console.log(r.area());"
      ],
