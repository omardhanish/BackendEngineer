  "pitfalls": [
    "Use `extends` only for a true is-a relation; prefer composition for has-a.",
    "Read `this` only after `super()` in a subclass constructor, or it throws.",
    "An underscore like `_balance` is only a convention; use `#balance` for real privacy."
  ],
  "quiz": {
    "q": "What does this print?",
    "code": "class Animal { speak() { return 'generic'; }\n  intro() { return this.speak(); } }\nclass Dog extends Animal { speak() { return 'woof'; } }\nconsole.log(new Dog().intro());",
    "lang": "js",
    "options": [
      "generic",
      "undefined",
      "woof",
      "TypeError"
    ],
    "answer": 2,
    "why": "`intro` runs on a `Dog`, so `this.speak()` finds `Dog`'s override first on the prototype chain."
  },
  "takeaway": "Hide state, share behaviour through polymorphism, and prefer composition to inheritance.",
